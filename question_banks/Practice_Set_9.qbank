     "example": false,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "print(is_magic([[8, 1, 6], [3, 5, 7], [4, 9, 3]]))",
     "stdin": "",
     "expected": "False",
     "extra": "",
