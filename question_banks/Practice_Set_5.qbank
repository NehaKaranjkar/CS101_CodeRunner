     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "print(list_product([5, -2, 0, 7], 0))",
     "stdin": "",
     "expected": "0",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
