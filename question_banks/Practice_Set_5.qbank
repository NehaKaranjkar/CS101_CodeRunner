     "testcode": "print(int_divide(4, 5))",
     "stdin": "",
     "expected": "0",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "print(int_divide(0, 3))",
     "stdin": "",
     "expected": "0",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
