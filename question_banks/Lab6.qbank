     "in_check": true
    },
    {
     "testcode": "",
     "stdin": "7",
     "expected": "Odd",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "",
     "stdin": "0",
     "expected": "Even",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "",
     "stdin": "-3",
     "expected": "Odd",
     "extra": "",
     "show": false,
     "example": false,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "",
     "stdin": "10",
     "expected": "Even",
     "extra": "",
     "show": false,
