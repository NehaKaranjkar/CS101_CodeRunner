     "in_check": true
    },
    {
     "testcode": "",
     "stdin": "1",
     "expected": "1",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "",
     "stdin": "5",
     "expected": "1\n2\n3\n4\n5",
     "extra": "",
     "show": false,
     "example": false,
