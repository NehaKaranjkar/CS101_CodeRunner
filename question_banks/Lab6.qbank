     "in_precheck": true,
     "in_check": true
    },
    {
     "testcode": "print(total_marks([50]))",
     "stdin": "",
     "expected": "50",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "lst = list(map(int, input().split()))\nprint(total_marks(lst))",
