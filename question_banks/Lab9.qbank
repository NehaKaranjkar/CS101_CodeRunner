     "in_precheck": false,
     "in_check": true
    }
   ]
  },
  {
   "xml_index": 26,
   "xml_name": "L09_026_Remove Versus Discard",
   "display_name": "Remove Versus Discard",
   "questiontext_html": "<p>Two methods remove an item from a set:</p>\n<ul><li><code>s.remove(x)</code> removes <code>x</code>, but raises a <code>KeyError</code> if <code>x</code> is not in the set;</li><li><code>s.discard(x)</code> removes <code>x</code> if it is there, and does <b>nothing</b> otherwise.</li></ul>\n<pre>s = {1, 2, 3}\ns.discard(2)\ns.discard(9)       # no error\nprint(sorted(s))</pre>\n<p>Output:</p>\n<pre>[1, 3]</pre>\n<p><b>Your task:</b> write the function <code>remove_all(s, items)</code>, which removes every item of the list <code>items</code> from the set <code>s</code>, if present (items that are not in <code>s</code> are ignored). It changes <code>s</code> and returns nothing.</p>\n<p>For example, after <code>s = {1, 2, 3}</code> and <code>remove_all(s, [2, 9])</code>, <code>sorted(s)</code> is <code>[1, 3]</code>.</p>",
   "answerpreload": "# Define remove_all(s, items): use discard.\n\n\n\n# ---- Use this space to test your code; comment it out before Check ----\n# s = {1, 2, 3}\n# remove_all(s, [2, 9])\n# print(sorted(s))\n",
   "mark": 1.0,
   "tests": [
    {
     "testcode": "s = {1, 2, 3}\nremove_all(s, [2, 9])\nprint(sorted(s))",
     "stdin": "",
     "expected": "[1, 3]",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": true,
     "in_check": true
    },
    {
     "testcode": "s = set()\nremove_all(s, [1])\nprint(sorted(s))",
     "stdin": "",
     "expected": "[]",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "s = {5, 6, 7}\nr = remove_all(s, [5, 6, 7, 7])\nprint(sorted(s), r)",
     "stdin": "",
     "expected": "[] None",
     "extra": "",
     "show": false,
     "example": false,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "s = {'a', 'b'}\nremove_all(s, [])\nprint(sorted(s))",
     "stdin": "",
     "expected": "['a', 'b']",
     "extra": "",
     "show": false,
     "example": false,
     "in_precheck": false,
     "in_check": true
    }
   ]
  },
  {
   "xml_index": 27,
   "xml_name": "L09_027_Seen Before",
   "display_name": "Seen Before",
   "questiontext_html": "<p>Sets are perfect for remembering \"what have I seen so far?\": checking <code>x in seen</code> is fast, and <code>seen.add(x)</code> records it.</p>\n<p><b>Indentation reminder:</b> the body of an <code>if</code>, loop, function or class must be indented (press Tab or type 4 spaces). Only the spaces at the start of a line matter.</p>\n<p><b>Your task:</b> write the function <code>first_repeat(L)</code>, which returns the first item of the list <code>L</code> that appears for the <b>second</b> time as you read <code>L</code> from left to right, or <code>None</code> if no item repeats.</p>\n<p>For example, <code>first_repeat([3, 1, 4, 1, 5, 3])</code> returns <code>1</code> (the second <code>1</code> comes before the second <code>3</code>).</p>",
   "answerpreload": "# Define first_repeat(L): remember the items seen so far in a set.\n\n\n\n# ---- Use this space to test your code; comment it out before Check ----\n# print(first_repeat([3, 1, 4, 1, 5, 3]))\n",
   "mark": 1.0,
   "tests": [
    {
     "testcode": "print(first_repeat([3, 1, 4, 1, 5, 3]))",
     "stdin": "",
     "expected": "1",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": true,
     "in_check": true
    },
    {
     "testcode": "print(first_repeat([1, 2, 3]))",
     "stdin": "",
     "expected": "None",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "print(first_repeat([]))",
     "stdin": "",
     "expected": "None",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "L = list(map(int, input().split()))\nprint(first_repeat(L))",
     "stdin": "7 8 9 9 8 7",
     "expected": "9",
     "extra": "",
     "show": false,
     "example": false,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "print(first_repeat(['a', 'a']))",
     "stdin": "",
     "expected": "a",
     "extra": "",
     "show": false,
     "example": false,
     "in_precheck": false,
     "in_check": true
    }
   ]
