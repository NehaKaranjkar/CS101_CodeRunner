     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "print(from_pairs([(\"k\", 1), (\"k\", 2)]))",
     "stdin": "",
     "expected": "{'k': 2}",
     "extra": "",
