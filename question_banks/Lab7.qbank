    {
     "testcode": "m = []\nadd_bonus(m, 5)\nprint(m)",
     "stdin": "",
     "expected": "[]",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "m = [100, 0]\nadd_bonus(m, 0)\nprint(m)",
