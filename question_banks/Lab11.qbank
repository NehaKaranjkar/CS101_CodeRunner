     "expected": "(-2, 0, 3, 5)",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": true,
     "in_check": true
    },
    {
     "testcode": "s = Scene()\ns.add(Point(4, 4))\nprint(s.bounding_box())",
     "stdin": "",
     "expected": "(4, 4, 4, 4)",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "s = Scene()\ns.add(Triangle(Point(0, 0), Point(10, 2), Point(3, -7)))\ns.add(Point(-1, 1))\ns.move_all(1, 1)\nprint(s.bounding_box())",
     "stdin": "",
