     "testcode": "s = Scene()\nline = Line(Point(1, 0), Point(1, 2))\nt = Triangle(Point(1, 1), Point(2, 1), Point(1, 2))\ns.add(line)\ns.add(t)\ns.rotate_all()\nprint(line)\nprint(t)",
     "stdin": "",
     "expected": "(0, 1)-(-2, 1)\n(-1, 1) (-1, 2) (-2, 1)",
