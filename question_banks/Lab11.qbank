     "testcode": "s = Scene()\nt = Triangle(Point(0, 0), Point(1, 0), Point(0, 1))\ns.add(t)\ns.move_all(-1, -1)\ns.move_all(0, 5)\nprint(t.a, t.b, t.c)",
