     "testcode": "t = Triangle(Point(1, 1), Point(4, 1), Point(1, 3))\nc = t.copy()\nc.move(5, 0)\nprint(t)\nprint(c)",
     "stdin": "",
     "expected": "(1, 1) (4, 1) (1, 3)\n(6, 1) (9, 1) (6, 3)",
