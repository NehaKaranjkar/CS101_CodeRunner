  {
   "xml_index": 12,
   "xml_name": "L11_012_Drawing A Triangle",
   "display_name": "Drawing A Triangle",
   "questiontext_html": "<p>A filled triangle is drawn with <code>ax.fill</code>, giving the x values and y values of the three corners in order (a, b, c). A see-through colour (<code>alpha=0.4</code>) lets overlapping shapes show.</p>\n<pre>ax.fill([x1, x2, x3], [y1, y2, y3], color=..., alpha=0.4)</pre>\n<p><b>Your task:</b> add the methods <code>draw(ax)</code>, which draws the triangle with <code>ax.fill</code> in its colour with <code>alpha=0.4</code>, and <code>points()</code>, which returns the list <code>[a, b, c]</code>.</p>\n<p>For example, drawing <code>Triangle(Point(0, 0), Point(4, 0), Point(2, 3), \"orange\")</code> records <code>('fill', [0, 4, 2], [0, 0, 3], 'orange')</code>.</p>",
   "answerpreload": "class Point:\n    def __init__(self, x, y, color=\"black\"):\n        self.x = x\n        self.y = y\n        self.color = color\n\n    def __str__(self):\n        return \"(\" + str(self.x) + \", \" + str(self.y) + \")\"\n\n    def move(self, dx, dy):\n        self.x = self.x + dx\n        self.y = self.y + dy\n\n    def distance_to(self, other):\n        return round(((other.x - self.x) ** 2 + (other.y - self.y) ** 2) ** 0.5, 2)\n\n    def draw(self, ax):\n        ax.scatter([self.x], [self.y], color=self.color)\n\n    def points(self):\n        return [self]\n\n\nclass Line:\n    def __init__(self, p1, p2, color=\"black\"):\n        self.p1 = p1            # two Point objects\n        self.p2 = p2\n        self.color = color\n\n    def length(self):\n        return self.p1.distance_to(self.p2)\n\n    def __str__(self):\n        return str(self.p1) + \"-\" + str(self.p2)\n\n    def midpoint(self):\n        return Point((self.p1.x + self.p2.x) / 2, (self.p1.y + self.p2.y) / 2, self.color)\n\n    def move(self, dx, dy):\n        self.p1.move(dx, dy)\n        self.p2.move(dx, dy)\n\n    def draw(self, ax):\n        ax.plot([self.p1.x, self.p2.x], [self.p1.y, self.p2.y], color=self.color)\n\n    def points(self):\n        return [self.p1, self.p2]\n\n\nclass Triangle:\n    def __init__(self, a, b, c, color=\"black\"):\n        self.a = a              # three Point objects\n        self.b = b\n        self.c = c\n        self.color = color\n\n    def perimeter(self):\n        return round(self.a.distance_to(self.b) + self.b.distance_to(self.c) + self.c.distance_to(self.a), 2)\n\n    def area(self):\n        a, b, c = self.a, self.b, self.c\n        return round(abs(a.x * (b.y - c.y) + b.x * (c.y - a.y) + c.x * (a.y - b.y)) / 2, 2)\n\n    def center(self):\n        cx = round((self.a.x + self.b.x + self.c.x) / 3, 2)\n        cy = round((self.a.y + self.b.y + self.c.y) / 3, 2)\n        return Point(cx, cy, self.color)\n\n    def move(self, dx, dy):\n        for p in (self.a, self.b, self.c):\n            p.move(dx, dy)\n\n    def scale(self, k):\n        c = self.center()\n        for p in (self.a, self.b, self.c):\n            p.x = round(c.x + k * (p.x - c.x), 2)\n            p.y = round(c.y + k * (p.y - c.y), 2)\n\n    def draw(self, ax):\n        # write your code here\n\n    def points(self):\n        # write your code here\n\n\n# ---- See your drawing (practice site only; not graded) ----\n# Remove the # in front of the lines below, then press Pre-check.\n# (Put the # back before Check if Check becomes slow.)\n# import matplotlib.pyplot as plt\n# fig, ax = plt.subplots()\n# ax.set_aspect('equal')\n# t = Triangle(Point(0, 0), Point(4, 0), Point(2, 3), \"orange\")\n# t.draw(ax)\n# t.center().draw(ax)\n# t.scale(0.5)\n# t.color = \"purple\"\n# t.draw(ax)\n",
   "mark": 1.0,
   "tests": [
    {
     "testcode": "class FakeAx:  # records drawing calls instead of drawing\n    def __init__(self): self.calls = []\n    def scatter(self, xs, ys, **kw): self.calls.append(('scatter', list(xs), list(ys), kw.get('color')))\n    def plot(self, xs, ys, **kw): self.calls.append(('plot', list(xs), list(ys), kw.get('color')))\n    def fill(self, xs, ys, **kw): self.calls.append(('fill', list(xs), list(ys), kw.get('color')))\nax = FakeAx()\nTriangle(Point(0, 0), Point(4, 0), Point(2, 3), \"orange\").draw(ax)\nfor c in ax.calls:\n    print(c)",
     "stdin": "",
     "expected": "('fill', [0, 4, 2], [0, 0, 3], 'orange')",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": true,
     "in_check": true
    },
    {
     "testcode": "class FakeAx:  # records drawing calls instead of drawing\n    def __init__(self): self.calls = []\n    def scatter(self, xs, ys, **kw): self.calls.append(('scatter', list(xs), list(ys), kw.get('color')))\n    def plot(self, xs, ys, **kw): self.calls.append(('plot', list(xs), list(ys), kw.get('color')))\n    def fill(self, xs, ys, **kw): self.calls.append(('fill', list(xs), list(ys), kw.get('color')))\nax = FakeAx()\nt = Triangle(Point(0, 0), Point(3, 0), Point(0, 3))\nt.draw(ax)\nt.move(1, 2)\nt.draw(ax)\nfor c in ax.calls:\n    print(c)",
     "stdin": "",
     "expected": "('fill', [0, 3, 0], [0, 0, 3], 'black')\n('fill', [1, 4, 1], [2, 2, 5], 'black')",
     "extra": "",
     "show": true,
