     "in_precheck": true,
     "in_check": true
    },
    {
     "testcode": "p = Point(-1, 0)\nprint(p, p.color)",
     "stdin": "",
     "expected": "(-1, 0) black",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
