  {
   "xml_index": 10,
   "xml_name": "L11_010_The Center Of A Triangle",
   "display_name": "The Center Of A Triangle",
   "questiontext_html": "<p>The <b>center</b> (centroid) of a triangle is the average of its three corners: <code>((x1 + x2 + x3) / 3, (y1 + y2 + y3) / 3)</code>. It is where a cardboard triangle would balance on a pencil tip.</p>\n<p><b>Your task:</b> add the method <code>center()</code> to <code>Triangle</code>, returning a <b>new</b> <code>Point</code> at the center (each coordinate rounded to 2 decimal places), with the triangle's colour.</p>\n<p>For example, <code>print(Triangle(Point(0, 0), Point(6, 0), Point(0, 3)).center())</code> prints <code>(2.0, 1.0)</code>.</p>",
   "answerpreload": "class Point:\n    def __init__(self, x, y, color=\"black\"):\n        self.x = x\n        self.y = y\n        self.color = color\n\n    def __str__(self):\n        return \"(\" + str(self.x) + \", \" + str(self.y) + \")\"\n\n    def move(self, dx, dy):\n        self.x = self.x + dx\n        self.y = self.y + dy\n\n    def distance_to(self, other):\n        return round(((other.x - self.x) ** 2 + (other.y - self.y) ** 2) ** 0.5, 2)\n\n    def draw(self, ax):\n        ax.scatter([self.x], [self.y], color=self.color)\n\n    def points(self):\n        return [self]\n\n\nclass Line:\n    def __init__(self, p1, p2, color=\"black\"):\n        self.p1 = p1            # two Point objects\n        self.p2 = p2\n        self.color = color\n\n    def length(self):\n        return self.p1.distance_to(self.p2)\n\n    def __str__(self):\n        return str(self.p1) + \"-\" + str(self.p2)\n\n    def midpoint(self):\n        return Point((self.p1.x + self.p2.x) / 2, (self.p1.y + self.p2.y) / 2, self.color)\n\n    def move(self, dx, dy):\n        self.p1.move(dx, dy)\n        self.p2.move(dx, dy)\n\n    def draw(self, ax):\n        ax.plot([self.p1.x, self.p2.x], [self.p1.y, self.p2.y], color=self.color)\n\n    def points(self):\n        return [self.p1, self.p2]\n\n\nclass Triangle:\n    def __init__(self, a, b, c, color=\"black\"):\n        self.a = a              # three Point objects\n        self.b = b\n        self.c = c\n        self.color = color\n\n    def perimeter(self):\n        return round(self.a.distance_to(self.b) + self.b.distance_to(self.c) + self.c.distance_to(self.a), 2)\n\n    def area(self):\n        a, b, c = self.a, self.b, self.c\n        return round(abs(a.x * (b.y - c.y) + b.x * (c.y - a.y) + c.x * (a.y - b.y)) / 2, 2)\n\n    def center(self):\n        # write your code here\n",
   "mark": 1.0,
   "tests": [
    {
     "testcode": "print(Triangle(Point(0, 0), Point(6, 0), Point(0, 3)).center())",
     "stdin": "",
     "expected": "(2.0, 1.0)",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": true,
     "in_check": true
    },
    {
     "testcode": "c = Triangle(Point(1, 1), Point(2, 2), Point(4, 1), 'red').center()\nprint(c, c.color)",
     "stdin": "",
     "expected": "(2.33, 1.33) red",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "print(Triangle(Point(-3, -3), Point(3, -3), Point(0, 6)).center())",
     "stdin": "",
     "expected": "(0.0, 0.0)",
     "extra": "",
