    },
    {
     "testcode": "print(sort_comparisons(10), binary_worst(10))",
     "stdin": "",
     "expected": "45 4",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "print(sort_comparisons(10 ** 6), binary_worst(10 ** 6))",
     "stdin": "",
     "expected": "499999500000 20",
     "extra": "",
     "show": false,
     "example": false,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "print(binary_worst(16), binary_worst(17))",
     "stdin": "",
