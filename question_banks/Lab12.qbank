    },
    {
     "testcode": "_c = {\"probe\": 0}\n_probe = probe\ndef probe(*args):\n    _c[\"probe\"] += 1\n    return _probe(*args)\nL = list(map(int, input().split()))\nprint(last_index(L, 3), 'looks:', _c['probe'])",
