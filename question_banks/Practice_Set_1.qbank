   "xml_index": 16,
   "xml_name": "PS1_016_MON_Sum One To N While",
   "display_name": "MON_Sum One To N While",
   "questiontext_html": "<p>Write a Python program that reads a positive integer <code>N</code> and prints the sum of all integers from 1 to <code>N</code> (inclusive), using a <code>while</code> loop.</p>\n<p><b>Example:</b> Input: <pre>5</pre> Output: <pre>15</pre></p>\n<p><b>Edge case:</b> Input: <pre>1</pre> Output: <pre>1</pre></p>",
   "answerpreload": "",
   "mark": 2.0,
   "tests": [
    {
     "testcode": "",
