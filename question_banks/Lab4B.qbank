   "xml_index": 2,
   "xml_name": "L04B_002_Add With Type Hints",
   "display_name": "Add With Type Hints",
   "questiontext_html": "<p>A function with more than one parameter simply repeats the same <code>name: type</code> pattern for each one, separated by commas.</p>\n<pre>def add(a: int, b: int) -> int:\n    return a + b</pre>\n<p>This tells us <code>add</code> expects two <code>int</code> arguments, and returns an <code>int</code>.</p>\n<p><b>Your task:</b> Complete the function <code>add</code> below (its type-hinted signature is already provided) so that it returns the sum of <code>a</code> and <code>b</code>.</p>\n<p><b>Example:</b> <code>add(3, 4)</code> should return <code>7</code>.</p>",
   "answerpreload": "def add(a: int, b: int) -> int:\n    # write your code here\n\n\n# ---- Use this space to test your function; comment it out before Check ----\n# print(add(3, 4))",
   "mark": 1.0,
   "tests": [
    {
     "testcode": "print(add(3, 4))",
     "stdin": "",
     "expected": "7",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": true,
     "in_check": true
    },
    {
     "testcode": "print(add(-5, 10))",
     "stdin": "",
     "expected": "5",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    },
    {
     "testcode": "print(add(0, 0))",
     "stdin": "",
     "expected": "0",
     "extra": "",
     "show": true,
     "example": true,
     "in_precheck": false,
     "in_check": true
    }
   ]
